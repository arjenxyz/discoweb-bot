# ============================================
# DiscoWeb Bot — ortam değişkenleri
# Kopyala: cp .env.example .env
# Render'da Environment → bu anahtarları ekle
# ============================================

# --- Zorunlu ---

# Discord Developer Portal → Bot → Token
DISCORD_TOKEN=

# Aynı uygulamanın Application ID (Client ID)
DISCORD_CLIENT_ID=

# Supabase → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# service_role (secret) — anon key KULLANMA
SUPABASE_SERVICE_ROLE_KEY=

# Web paneli ile paylaşılan API anahtarı (uzun rastgele string)
# Web tarafında da aynı değer: BOT_API_KEY
BOT_API_KEY=

# DiscoWeb web panel URL (CORS + linkler)
# Örn: https://discowebtr.vercel.app
WEB_URL=https://your-web.vercel.app

# --- Render / HTTP API ---

# Render Web Service otomatik verir; yerelde genelde 3000
PORT=3000
# İstersen ayrı port: BOT_API_PORT=3000

# CORS için ek origin'ler (virgülle). WEB_URL zaten eklenir.
# BOT_API_ORIGINS=https://discowebtr.vercel.app,http://localhost:3000

# --- Discord / sunucu (çoğu ayar web panelden gelir; bunlar fallback) ---

# Ana geliştirici / varsayılan guild (opsiyonel)
GUILD_ID=
DEVELOPER_GUILD_ID=

# Üye doğrulama rolü fallback (setup sonrası servers.verify_role_id kullanılır)
REQUIRED_ROLE_ID=
# DISCORD_REQUIRED_ROLE_ID=

DISCORD_ADMIN_ROLE_ID=
SYSTEM_LOG_CHANNEL_ID=

# --- Kazanç varsayılanları (sunucu ayarı yoksa) ---
# Gerçek oranlar genelde web panel → Earn Settings / servers tablosundan gelir

PAPEL_PER_MESSAGE=0.2
PAPEL_PER_VOICE_MINUTE=0.2
# TR = UTC+3 → 180 dakika
PAPEL_TIMEZONE_OFFSET=180

# --- Performans (opsiyonel) ---

# Mesaj/ses kazanç buffer flush
EARN_BUFFER_FLUSH_MS=8000
EARN_BUFFER_MAX_ENTRIES=2000
SERVER_CONFIG_TTL_MS=300000
VOICE_CONFIG_TTL_MS=300000

# Mağaza sipariş tarama aralığı (ms)
ORDER_POLL_INTERVAL_MS=300000

# --- Quiz (web cron ile ortak secret) ---
# Web panel QUIZ_CRON_SECRET ile aynı olmalı
QUIZ_CRON_SECRET=
# QUIZ_TICK_INTERVAL_MS=5000
# QUIZ_PAYOUT_INTERVAL_MS=60000

# --- Opsiyonel site URL alias'ları ---
# SITE_URL=
# NEXT_PUBLIC_SITE_URL=
# NEXT_PUBLIC_APP_URL=
# WEB_BASE_URL=
